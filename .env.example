# Copy to .env and fill in. Never commit real values — .env is gitignored.

# ── Nalopay ───────────────────────────────────────────────────────────────
# From merchant.nalopay.com → Developer tab. All three are required.
# NALOPAY_BASIC_AUTH is the token WITHOUT the "Basic " prefix.
NALOPAY_MERCHANT_ID=
NALOPAY_BASIC_AUTH=
NALOPAY_SECRET_KEY=

# Optional: forces the checkout test-mode banner on.
NALOPAY_TEST_MODE=false

# ── Core ──────────────────────────────────────────────────────────────────
DATABASE_URL=
COWRIE_SECRET=
BASE_URL=https://cowrie-gateway.onrender.com

# ── Admin console ─────────────────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Email (Resend preferred; Gmail is the fallback) ───────────────────────
RESEND_API_KEY=
EMAIL_FROM=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Cloudinary (KYC document storage) ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
