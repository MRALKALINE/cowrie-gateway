# Copy to .env and fill in. Never commit real values — .env is gitignored.

# ── MCASH (app.arkmah.com) — primary gateway ──────────────────────────────
# Without any keys, live payments use the static pay-link below: the payer
# enters the amount on MCASH's page and an admin confirms each payment by
# hand (admin console → mark paid). Setting the API keys (app.arkmah.com →
# Developer) upgrades this to hosted checkout with automatic confirmation.
MCASH_PAYLINK_URL=https://app.arkmah.com/pay-link/ucauuiujzvfi
MCASH_PUBLIC_KEY=
MCASH_SECRET_KEY=
MCASH_TEST_PUBLIC_KEY=
MCASH_TEST_SECRET_KEY=

# Optional: forces the checkout test-mode banner on.
MCASH_TEST_MODE=false

# ── Nalopay — fallback gateway, used only when MCASH is not configured ─────
# From merchant.nalopay.com → Developer tab. All three are required.
# NALOPAY_BASIC_AUTH is the token WITHOUT the "Basic " prefix.
NALOPAY_MERCHANT_ID=
NALOPAY_BASIC_AUTH=
NALOPAY_SECRET_KEY=
NALOPAY_TEST_MODE=false

# ── Core ──────────────────────────────────────────────────────────────────
DATABASE_URL=
COWRIE_SECRET=
BASE_URL=https://cowrie-gateway.onrender.com

# ── Admin console ─────────────────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Email (Resend preferred; Gmail is the fallback) ───────────────────────
RESEND_API_KEY=
EMAIL_FROM=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Cloudinary (KYC document storage) ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
